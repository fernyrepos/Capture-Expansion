<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="FurnitureBase" Name="CE_CapturePlatformBase" Abstract="True">
    <thingClass>CaptureExpansion.Building_RestraintPlatform</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <passability>PassThroughOnly</passability>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <uiOrder>100</uiOrder>
    <pathCost>30</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <defaultPlacingRot>North</defaultPlacingRot>
    <designationCategory>Furniture</designationCategory>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities />
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="CE_CapturePlatformBase">
    <defName>CE_RestraintChair</defName>
    <label>restraint chair</label>
    <description>A chair built for restraining prisoners. Has mounted cuffs to prevent movement of the arms.</description>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <researchPrerequisites>
      <li>CE_RestraintChairResearch</li>
    </researchPrerequisites>
    <graphicData>
      <texPath>Things/Building/DungeonProps/Misc/RusticCuffsChair</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <statBases>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>25</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_EntityHolderPlatform">
        <containmentFactor>0.4</containmentFactor>
      </li>
    </comps>
    <modExtensions>
      <li Class="CaptureExpansion.RestraintExtension">
        <heldPawnPosture>Standing</heldPawnPosture>
        <faceRotation>false</faceRotation>
        <pawnDrawOffsetNorth>(0, 0.01, 0.15)</pawnDrawOffsetNorth>
        <pawnDrawOffsetEast>(0, 0.01, 0.25)</pawnDrawOffsetEast>
        <pawnDrawOffsetSouth>(0, -1, 0.15)</pawnDrawOffsetSouth>
        <pawnDrawOffsetWest>(0, 0.01, 0.25)</pawnDrawOffsetWest>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="CE_CapturePlatformBase">
    <defName>CE_RestraintRack</defName>
    <label>restraint rack</label>
    <description>A large rack built for holding prisoners. Has mounted cuffs to prevent movement of the arms or legs.</description>
    <researchPrerequisites>
      <li>CE_RestraintRackResearch</li>
    </researchPrerequisites>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <graphicData>
      <texPath>Things/Building/DungeonProps/Misc/TortureRack</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <uiIconScale>0.75</uiIconScale>
    <size>(1,2)</size>
    <costList>
      <WoodLog>85</WoodLog>
    </costList>
    <statBases>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>30</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_EntityHolderPlatform">
        <containmentFactor>0.85</containmentFactor>
      </li>
    </comps>
    <modExtensions>
      <li Class="CaptureExpansion.RestraintExtension">
        <pawnDrawOffsetNorth>(0, 0.01, 0.25)</pawnDrawOffsetNorth>
        <pawnDrawOffsetEast>(0, 0.01, 0.25)</pawnDrawOffsetEast>
        <pawnDrawOffsetSouth>(0, 0.01, 0.25)</pawnDrawOffsetSouth>
        <pawnDrawOffsetWest>(0, 0.01, 0.25)</pawnDrawOffsetWest>
        <angleOffsetEast>14</angleOffsetEast>
        <angleOffsetWest>-14</angleOffsetWest>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="CE_CapturePlatformBase">
    <defName>CE_RestraintPole</defName>
    <label>restraint pole</label>
    <description>A vertical pole built for restraining prisoners. Has mounted cuffs to prevent movement of the arms or legs.</description>
    <researchPrerequisites>
      <li>CE_RestraintPoleResearch</li>
    </researchPrerequisites>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <graphicData>
      <texPath>Things/Building/DungeonProps/Misc/Pole/Pole_B</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,3)</drawSize>
      <drawOffset>(0,0,0.1)</drawOffset>
    </graphicData>
    <uiIconScale>0.75</uiIconScale>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <Mass>15</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_EntityHolderPlatform">
        <containmentFactor>0.3</containmentFactor>
      </li>
      <li Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
        <randomGraphics>
          <li>Things/Building/DungeonProps/Misc/Pole/Pole_A</li>
          <li>Things/Building/DungeonProps/Misc/Pole/Pole_B</li>
          <li>Things/Building/DungeonProps/Misc/Pole/Pole_C</li>
        </randomGraphics>
        <optionalNames>
          <li>Pole A</li>
          <li>Pole B</li>
          <li>Pole C</li>
        </optionalNames>
      </li>
    </comps>
    <modExtensions>
      <li Class="CaptureExpansion.RestraintExtension">
        <heldPawnPosture>Standing</heldPawnPosture>
        <faceRotation>false</faceRotation>
        <pawnDrawOffsetNorth>(0, 0.01, 0.1)</pawnDrawOffsetNorth>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="CE_CapturePlatformBase">
    <defName>CE_Pillory</defName>
    <label>pillory</label>
    <description>A wooden restraint that holds a prisoner upright by the neck and wrists.</description>
    <researchPrerequisites>
      <li>CE_PilloryResearch</li>
    </researchPrerequisites>
    <graphicData>
      <texPath>Things/Building/DungeonProps/Misc/Pillory</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <uiIconScale>0.75</uiIconScale>
    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <costList>
      <WoodLog>50</WoodLog>
    </costList>
    <statBases>
      <WorkToBuild>900</WorkToBuild>
      <Mass>20</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_EntityHolderPlatform">
        <containmentFactor>0.5</containmentFactor>
      </li>
    </comps>
    <modExtensions>
      <li Class="CaptureExpansion.RestraintExtension">
        <heldPawnPosture>LayingOnGroundNormal</heldPawnPosture>
        <faceRotation>false</faceRotation>
        <usePlatformAngle>false</usePlatformAngle>
        <crawlingHeadNorth>true</crawlingHeadNorth>
        <fixedRotation>North</fixedRotation>
        <angleOffsetEast>-35</angleOffsetEast>
        <angleOffsetWest>35</angleOffsetWest>
        <pawnDrawOffsetEast>(-0.2, -0.01, 0.05)</pawnDrawOffsetEast>
        <pawnDrawOffsetWest>(0.2, -0.01, 0.05)</pawnDrawOffsetWest>
        <bodyDrawOffsetNorth>(0, -0.1, -0.15)</bodyDrawOffsetNorth>
        <bodyDrawOffsetSouth>(0, 0.1, 0.15)</bodyDrawOffsetSouth>
        <headDrawOffsetNorth>(0, 0.05, -0.15)</headDrawOffsetNorth>
        <headDrawOffsetEast>(0, 0.05, 0)</headDrawOffsetEast>
        <headDrawOffsetSouth>(0, -0.05, 0.15)</headDrawOffsetSouth>
        <headDrawOffsetWest>(0, 0.05, 0)</headDrawOffsetWest>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="CE_CapturePlatformBase">
    <defName>CE_Guillotine</defName>
    <label>guillotine</label>
    <description>A restraint fitted with a weighted blade for beheading a captive.</description>
    <researchPrerequisites>
      <li>CE_GuillotineResearch</li>
    </researchPrerequisites>
    <graphicData>
      <texPath>Things/Building/DungeonProps/Misc/Guillotine</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,3)</drawSize>
      <drawOffset>(0,0,0.25)</drawOffset>
    </graphicData>
    <uiIconScale>0.45</uiIconScale>
    <uiIconOffset>(0,0.15)</uiIconOffset>
    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <costList>
      <WoodLog>40</WoodLog>
      <Steel>20</Steel>
    </costList>
    <statBases>
      <WorkToBuild>1100</WorkToBuild>
      <Mass>25</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_EntityHolderPlatform">
        <containmentFactor>0.5</containmentFactor>
      </li>
      <li Class="CaptureExpansion.CompProperties_Guillotine">
        <iconTexPath>Things/Building/DungeonProps/Misc/Guillotine_south</iconTexPath>
      </li>
    </comps>
    <modExtensions>
      <li Class="CaptureExpansion.RestraintExtension">
        <heldPawnPosture>LayingOnGroundNormal</heldPawnPosture>
        <faceRotation>false</faceRotation>
        <usePlatformAngle>false</usePlatformAngle>
        <crawlingHeadNorth>true</crawlingHeadNorth>
        <fixedRotation>North</fixedRotation>
        <angleOffsetEast>-35</angleOffsetEast>
        <angleOffsetWest>35</angleOffsetWest>
        <pawnDrawOffsetEast>(-0.2, -0.01, 0.3)</pawnDrawOffsetEast>
        <pawnDrawOffsetWest>(0.2, -0.01, 0.3)</pawnDrawOffsetWest>
        <bodyDrawOffsetNorth>(0, -0.1, -0.15)</bodyDrawOffsetNorth>
        <bodyDrawOffsetSouth>(0, 0.1, 0.3)</bodyDrawOffsetSouth>
        <headDrawOffsetNorth>(0, 0.05, -0.15)</headDrawOffsetNorth>
        <headDrawOffsetEast>(0, 0.05, 0)</headDrawOffsetEast>
        <headDrawOffsetSouth>(0, -0.05, 0.15)</headDrawOffsetSouth>
        <headDrawOffsetWest>(0, 0.05, 0)</headDrawOffsetWest>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BedBase">
    <defName>CE_WallMountedCot</defName>
    <label>wall-mounted cot</label>
    <description>A cheap and rough wooden board mounted to a wall, uncomfortable and thus commonly used in prisons.</description>
    <researchPrerequisites>
      <li>CE_WallMountedCotResearch</li>
    </researchPrerequisites>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <graphicData>
      <texPath>Things/Building/DungeonProps/Misc/RusticPrisonBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,3)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <size>(1,2)</size>
    <drawGUIOverlay>True</drawGUIOverlay>
    <designationCategory>Furniture</designationCategory>
    <building>
      <bed_showSleeperBody>True</bed_showSleeperBody>
      <bed_healPerDay>4</bed_healPerDay>
      <buildingTags>
        <li>Bed</li>
      </buildingTags>
    </building>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>CaptureExpansion.PlaceWorker_WallCot</li>
    </placeWorkers>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <Mass>30</Mass>
      <Comfort>0.2</Comfort>
      <BedRestEffectiveness>0.4</BedRestEffectiveness>
      <ImmunityGainSpeedFactor>1.05</ImmunityGainSpeedFactor>
      <TerrorSource MayRequire="Ludeon.RimWorld.Ideology">5</TerrorSource>
      <Beauty>-5</Beauty>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>20</costStuffCount>
    <comps>
      <li Class="CompProperties_AssignableToPawn">
        <drawAssignmentOverlay>false</drawAssignmentOverlay>
        <compClass>CompAssignableToPawn_Bed</compClass>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>EndTable</li>
          <li>Dresser</li>
        </linkableFacilities>
      </li>
    </comps>
    <replaceTags>
      <li>Bed</li>
    </replaceTags>
  </ThingDef>

  <ThingDef ParentName="BedBase" Name="CE_CageBase" Abstract="True">
    <thingClass>CaptureExpansion.Building_Cage</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <drawerType>MapMeshAndRealTime</drawerType>
    <designationCategory>Furniture</designationCategory>
    <defaultPlacingRot>North</defaultPlacingRot>
    <rotatable>false</rotatable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>20</Mass>
      <Comfort>0.3</Comfort>
      <BedRestEffectiveness>0.6</BedRestEffectiveness>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <building>
      <bed_showSleeperBody>True</bed_showSleeperBody>
      <bed_humanlike>True</bed_humanlike>
    </building>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities />
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="CE_CageBase">
    <defName>CE_CageSmall</defName>
    <label>small prisoner cage</label>
    <description>A compact barred enclosure for confining a single prisoner.</description>
    <researchPrerequisites>
      <li>CE_PrisonerCages</li>
    </researchPrerequisites>
    <size>(2,2)</size>
    <costStuffCount>100</costStuffCount>
    <uiIconPath>UI/Architect/Cages/CE_CageSmall</uiIconPath>
    <uiIconScale>1.25</uiIconScale>
    <graphicData>
      <texPath>Things/Building/DungeonProps/LargeCages/CageBase_Metal_2x2</texPath>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <modExtensions>
      <li Class="CaptureExpansion.CageExtension">
        <topGraphicData>
          <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Flat_2x2</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(4,4)</drawSize>
          <shaderType>Transparent</shaderType>
        </topGraphicData>
      </li>
    </modExtensions>
    <comps>
      <li Class="CaptureExpansion.CompProperties_CageTopGraphicVariation">
        <topGraphics>
          <li>
            <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Flat_2x2</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(4,4)</drawSize>
            <shaderType>Transparent</shaderType>
          </li>
          <li>
            <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Spike_2x2</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(4,4)</drawSize>
            <shaderType>Transparent</shaderType>
          </li>
          <li>
            <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Shoddy_2x2</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(4,4)</drawSize>
            <shaderType>Transparent</shaderType>
          </li>
        </topGraphics>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="CE_CageBase">
    <defName>CE_CageMedium</defName>
    <label>medium prisoner cage</label>
    <description>A barred enclosure with enough room for two prisoners.</description>
    <researchPrerequisites>
      <li>CE_PrisonerCages</li>
    </researchPrerequisites>
    <costStuffCount>150</costStuffCount>
    <size>(3,2)</size>
    <uiIconPath>UI/Architect/Cages/CE_CageMedium</uiIconPath>
    <uiIconScale>1.25</uiIconScale>
    <graphicData>
      <texPath>Things/Building/DungeonProps/LargeCages/CageBase_Metal_3x2_north</texPath>
      <drawSize>(5,4)</drawSize>
    </graphicData>
    <modExtensions>
      <li Class="CaptureExpansion.CageExtension">
        <topGraphicData>
          <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Flat_3x2_north</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(5,4)</drawSize>
          <shaderType>Transparent</shaderType>
        </topGraphicData>
      </li>
    </modExtensions>
    <comps>
      <li Class="CaptureExpansion.CompProperties_CageTopGraphicVariation">
        <topGraphics>
          <li>
            <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Flat_3x2_north</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,4)</drawSize>
            <shaderType>Transparent</shaderType>
          </li>
          <li>
            <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Spike_3x2_north</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,4)</drawSize>
            <shaderType>Transparent</shaderType>
          </li>
          <li>
            <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Shoddy_3x2_north</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,4)</drawSize>
            <shaderType>Transparent</shaderType>
          </li>
        </topGraphics>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="CE_CageBase">
    <defName>CE_CageLarge</defName>
    <label>large prisoner cage</label>
    <costStuffCount>200</costStuffCount>
    <description>A spacious barred enclosure for holding up to four prisoners.</description>
    <researchPrerequisites>
      <li>CE_PrisonerCages</li>
    </researchPrerequisites>
    <size>(3,3)</size>
    <uiIconPath>UI/Architect/Cages/CE_CageLarge</uiIconPath>
    <uiIconScale>1.25</uiIconScale>
    <graphicData>
      <texPath>Things/Building/DungeonProps/LargeCages/CageBase_Metal_3x3</texPath>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <modExtensions>
      <li Class="CaptureExpansion.CageExtension">
        <topGraphicData>
          <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Flat_3x3</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(5,5)</drawSize>
          <shaderType>Transparent</shaderType>
        </topGraphicData>
      </li>
    </modExtensions>
    <comps>
      <li Class="CaptureExpansion.CompProperties_CageTopGraphicVariation">
        <topGraphics>
          <li>
            <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Flat_3x3</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
            <shaderType>Transparent</shaderType>
          </li>
          <li>
            <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Spike_3x3</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
            <shaderType>Transparent</shaderType>
          </li>
          <li>
            <texPath>Things/Building/DungeonProps/LargeCages/CageTop_Shoddy_3x3</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5,5)</drawSize>
            <shaderType>Transparent</shaderType>
          </li>
        </topGraphics>
      </li>
    </comps>
  </ThingDef>
</Defs>
