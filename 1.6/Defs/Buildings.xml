    </graphicData>
    <size>(1,1)</size>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <Mass>20</Mass>
      <Comfort>0.4</Comfort>
      <BedRestEffectiveness>0.4</BedRestEffectiveness>
    </statBases>
    <building>
      <bed_showSleeperBody>True</bed_showSleeperBody>
      <bed_humanlike>True</bed_humanlike>
    </building>
