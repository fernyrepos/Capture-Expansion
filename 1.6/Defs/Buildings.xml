<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="FurnitureBase" Name="CE_CapturePlatformBase" Abstract="True">
    <thingClass>CaptureExpansion.Building_RestraintPlatform</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <passability>PassThroughOnly</passability>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <uiOrder>100</uiOrder>
    <pathCost>30</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <defaultPlacingRot>North</defaultPlacingRot>
    <minMonolithLevel>1</minMonolithLevel>
    <designationCategory>Anomaly</designationCategory>
    <building>
      <buildingTags>
        <li>Anomaly</li>
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities />
      </li>
    </comps>
    <modExtensions>
      <li Class="CaptureExpansion.RestraintExtension" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="CE_CapturePlatformBase">
    <defName>CE_RestraintChair</defName>
    <label>restraint chair</label>
    <description>todo</description>
    <graphicData>
      <texPath>Things/Building/DungeonProps/Misc/RusticCuffsChair</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <statBases>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>25</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_EntityHolderPlatform">
        <containmentFactor>0.5</containmentFactor>
      </li>
    </comps>
  </ThingDef>

